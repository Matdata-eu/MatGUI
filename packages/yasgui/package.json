{
  "name": "@matdata/yasgui",
  "description": "MatGUI: a modern SPARQL query editor and results viewer for knowledge graphs and linked data (formerly Yasgui).",
  "version": "4.6.1",
  "main": "build/yasgui.cjs",
  "module": "build/yasgui.mjs",
  "unpkg": "build/yasgui.min.js",
  "jsdelivr": "build/yasgui.min.js",
  "types": "build/ts/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/ts/src/index.d.ts",
      "import": "./build/yasgui.mjs",
      "require": "./build/yasgui.cjs",
      "default": "./build/yasgui.mjs"
    },
    "./build/yasgui.min.css": "./build/yasgui.min.css",
    "./build/*": "./build/*",
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "author": "Triply <info@triply.cc>",
  "homepage": "https://github.com/Matdata-eu/Yasgui",
  "keywords": [
    "JavaScript",
    "SPARQL",
    "Editor",
    "Semantic Web",
    "Linked Data"
  ],
  "bugs": "https://github.com/Matdata-eu/Matgui/issues/",
  "repository": {
    "type": "git",
    "url": "https://github.com/Matdata-eu/Matgui.git",
    "directory": "packages/yasgui"
  },
  "dependencies": {
    "@tarekraafat/autocomplete.js": "^7.2.0",
    "@matdata/yasgui-utils": "^4.6.1",
    "@matdata/yasqe": "^4.6.1",
    "@matdata/yasr": "^4.6.1",
    "autosuggest-highlight": "^3.1.1",
    "blueimp-md5": "^2.12.0",
    "choices.js": "^9.0.1",
    "dompurify": "^3.2.4",
    "es6-object-assign": "^1.1.0",
    "jsuri": "^1.3.1",
    "lodash-es": "^4.17.15",
    "sortablejs": "^1.10.2",
    "@matdata/yasgui-graph-plugin": "^1.6.1",
    "@matdata/yasgui-table-plugin": "^1.3.0"
  },
  "devDependencies": {
    "@types/autosuggest-highlight": "^3.1.0",
    "@types/blueimp-md5": "^2.7.0",
    "@types/jsuri": "^1.3.30",
    "@types/lodash-es": "^4.17.3",
    "@types/node": "^22.5.4"
  },
  "publishConfig": {
    "access": "public"
  }
}
